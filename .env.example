# AI Vision Assistant 2026 - Environment Configuration

# Groq Cloud API Key (Get free key at https://console.groq.com)
# Powers Llama 4 Scout / Llama 3.2 Multimodal Vision & Whisper-large-v3-turbo
GROQ_API_KEY=your_groq_api_key_here

# Multimodal Vision Model (default: llama-3.2-11b-vision-preview or meta-llama/llama-4-scout)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Server Configuration
HOST=0.0.0.0
PORT=8000

